levenshtein () {
    if [ "$#" -ne 2 ]; then
        echo "Usage: levenshtein <string1> <string2>"
        return 1
    fi

    local s1="$1" s2="$2"
    local len1=${s1} len2=${#s2}
    local i j c1 c2
    local -a d

    for ((i=0; i<=len1; i++)); do d[$i,0]=$i; done
    for ((j=0; j<=len2; j++)); do d[0,$j]=$j; done

    for ((i=1; i<=len1; i++)); do
        c1=${s1:i-1:1}
        for ((j=1; j<=len2; j++)); do
            c2=${s2:j-1:1}
            if [ "$c1" == "$c2" ]; then
                d[$i,$j]=${d[$i-1,$j-1]}
            else
                local sub=${d[$i-1,$j-1]}
                local ins=${d[$i,$j-1]}
                local del=${d[$i-1,$j]}
                local min=$sub
                if [ $ins -lt $min ]; then min=$ins; fi
                if [ $del -lt $min ]; then min=$del; fi
                d[$i,$j]=$((min+1))
            fi
        done
    done
    echo ${d[$len1,$len2]}
}

