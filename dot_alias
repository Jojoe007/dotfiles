function change() {
  git show --name-status $1 | grep -Eo "(?:crates/)(\w|-)+" | sort | uniq
}

function pick-commit() {
  card_id=$(echo "${1#*/}" | cut -d '-' -f 1,2)
  echo "git cherry-pick $(git log $1 --no-merges --reverse --pretty=format:"%h" --grep "$card_id" | tr '\n' ' ')"
}
alias pick-commit-current="pick-commit $(git branch --show-current)"

