zmodload zsh/zprof


export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH
export MANPATH="/usr/local/man:$MANPATH"
export ARCHFLAGS="-arch $(uname -m)"
export ZSH="$HOME/.oh-my-zsh"
export LANG=en_US.UTF-8

ZSH_THEME="robbyrussell-improve"

plugins=(
  enhancd
  zsh-autosuggestions
  # jenv
  # cargo-zsh-completion
  # rustup-zsh-completion
  # diesel-zsh-completion
)

source $ZSH/oh-my-zsh.sh
source "$HOME/.alias"

if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

alias go-home="cd ~"
alias open-home="open ~"
alias open-caches="open ~/Library/Caches"
alias ls="eza -la"
alias zshconfig="$EDITOR ~/.zshrc"
alias zshenv="$EDITOR ~/.zshenv"
alias alias-edit="$EDITOR ~/.alias"
alias ohmyzsh="open ~/.oh-my-zsh"
alias view-path="echo ${PATH} | tr -s ':' '\n'"
alias extract-path="echo $PATH | sed 's/\/Users\/jojoe007/$HOME/g' | sed 's/:/ \\ \n/g'"

if [ "$(arch)" = "arm64" ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/usr/local/bin/brew shellenv)"
fi

eval "$(direnv hook $SHELL)"
eval "$(rbenv init - zsh)"
eval "$(jenv init -)"

# pnpm
export PNPM_HOME="/Users/jojoe007/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/opt/homebrew/Caskroom/miniconda/base/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh" ]; then
        . "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
    else
        export PATH="/opt/homebrew/Caskroom/miniconda/base/bin:$PATH"
    fi
fi
unset __conda_setup

conda activate gother

